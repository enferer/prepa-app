# Configuration du deploiement. Copier en .env a cote de docker-compose.prod.yml.
# Ce fichier ne doit jamais rejoindre le depot.

# Base de donnees
DB_NAME=prepa
DB_USER=prepa
DB_PASSWORD=

# Signature des jetons d'acces. Au moins 32 octets.
#   openssl rand -base64 48
JWT_SECRET=

# Chiffrement des identifiants Garmin au repos. Cle AES de 32 octets en base64.
#   openssl rand -base64 32
# Changer cette cle rend les identifiants deja stockes illisibles : il faut alors
# les ressaisir.
CRYPTO_KEY=

# Cle de service du worker, creee par l'API avec le droit d'ingestion.
WORKER_SERVICE_KEY=

# Cadence du passage complet de synchronisation Garmin, en secondes.
SYNC_INTERVALLE_S=1800

# Port d'ecoute de l'application sur l'hote. Le 80 appartient a un autre service.
WEB_PORT=8080
