# Configuration du deploiement. Copier en .env a cote de docker-compose.prod.yml.
# Ce fichier ne doit jamais rejoindre le depot.

# Base de donnees
DB_NAME=prepa
DB_USER=prepa
DB_PASSWORD=

# Signature des jetons d'acces. Au moins 32 octets.
#   openssl rand -base64 48
JWT_SECRET=

# Chiffrement des identifiants Garmin au repos. Cle AES de 32 octets en base64.
#   openssl rand -base64 32
# Changer cette cle rend les identifiants deja stockes illisibles : il faut alors
# les ressaisir.
CRYPTO_KEY=

# Cle de service des skills, creee par l'API avec les droits de coach et d'ingestion.
# C'est par elle que /prepa-update declenche une synchronisation.
PREPA_SERVICE_KEY=

# Port d'ecoute de l'application sur l'hote. Le 80 appartient a un autre service.
WEB_PORT=8080

# Origine depuis laquelle le navigateur appelle l'API : le protocole, le nom et le port
# tels qu'ils apparaissent dans la barre d'adresse. Le navigateur envoie cet en-tete meme
# lorsque la page et l'API partagent la meme origine — s'il ne figure pas ici, la
# connexion echoue avec un 403.
PREPA_ORIGINES=http://vps-75154aed.vps.ovh.net:8080
