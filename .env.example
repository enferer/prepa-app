# Identifiants Garmin Connect — utilisés par scripts/garmin_sync.py
#
# MULTI-PROFILS : chaque athlète a son propre compte Garmin, donc son propre
# fichier. Copier ce modèle dans le dossier du profil :
#
#     cp .env.example profiles/thibaut/.env
#     cp .env.example profiles/camille/.env
#
# Un `.env` placé ici, à la racine, ne sert que de repli pour les profils qui
# n'ont pas le leur (installation mono-athlète). Tous sont gitignorés.

GARMIN_EMAIL=ton.email@exemple.com
GARMIN_PASSWORD=ton-mot-de-passe
